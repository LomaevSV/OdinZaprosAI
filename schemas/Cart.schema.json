{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odin:contracts:1.0.0:Cart",
  "$defs": {
    "CartItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "outbound",
            "return",
            "hotel",
            "transfer_in",
            "transfer_out"
          ],
          "title": "Role",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "data_mode": {
          "enum": [
            "live",
            "replay",
            "mock"
          ],
          "title": "Data Mode",
          "type": "string"
        },
        "price": {
          "$ref": "#/$defs/Price"
        },
        "availability_status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ],
          "title": "Availability Status",
          "type": "string"
        },
        "informational": {
          "title": "Informational",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        }
      },
      "required": [
        "item_id",
        "component_id",
        "role",
        "kind",
        "title",
        "data_mode",
        "price",
        "availability_status",
        "informational",
        "note",
        "source"
      ],
      "title": "CartItem",
      "type": "object"
    },
    "Fee": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "description": "Decimal строкой",
              "pattern": "^\\d+(\\.\\d{1,2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "description": "Код ISO 4217",
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "included": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Included"
        }
      },
      "required": [
        "name",
        "amount",
        "currency",
        "included"
      ],
      "title": "Fee",
      "type": "object"
    },
    "Price": {
      "additionalProperties": false,
      "description": "Нормативные поля PRICE-01. Полная цена — за всех путешественников и весь период.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "description": "Decimal строкой",
              "pattern": "^\\d+(\\.\\d{1,2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "description": "Код ISO 4217",
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "price_scope": {
          "enum": [
            "per_person",
            "per_seat",
            "party_total",
            "per_night",
            "stay_total",
            "per_room_stay",
            "trip_total",
            "unknown"
          ],
          "title": "Price Scope",
          "type": "string"
        },
        "guests": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Guests"
        },
        "rooms": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rooms"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/PricePeriod"
            },
            {
              "type": "null"
            }
          ]
        },
        "inclusions": {
          "items": {
            "type": "string"
          },
          "title": "Inclusions",
          "type": "array"
        },
        "known_fees": {
          "items": {
            "$ref": "#/$defs/Fee"
          },
          "title": "Known Fees",
          "type": "array"
        },
        "mandatory_fees_status": {
          "enum": [
            "included",
            "excluded_known",
            "unknown",
            "not_applicable"
          ],
          "title": "Mandatory Fees Status",
          "type": "string"
        },
        "total_completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Total Completeness",
          "type": "string"
        },
        "unknown_reason": {
          "anyOf": [
            {
              "enum": [
                "not_provided_by_source",
                "source_error",
                "timeout",
                "budget_exhausted",
                "not_requested",
                "estimate_only",
                "not_supported_field",
                "mock_data",
                "currency_unresolved",
                "price_incomplete",
                "buffer_not_approved",
                "decision_pending",
                "data_missing",
                "stale"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unknown Reason"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency",
        "price_scope",
        "guests",
        "rooms",
        "period",
        "mandatory_fees_status",
        "total_completeness",
        "unknown_reason",
        "source",
        "as_of"
      ],
      "title": "Price",
      "type": "object"
    },
    "PricePeriod": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "PricePeriod",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "Происхождение существенного факта (DATA-MODE-02, CONTRACT-01).\n\n``verification_status=verified`` означает подтверждение конкретным источником, а не объективную истину.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "mcp",
            "rest_api",
            "local_dataset",
            "mock_generator",
            "editorial",
            "user_input",
            "computed",
            "llm"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "provider": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https?://[^\\s]{1,2000}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrieved At"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generated At"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "External Id"
        },
        "verification_status": {
          "enum": [
            "verified",
            "unverified",
            "conflicting",
            "stale"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "data_mode": {
          "enum": [
            "live",
            "replay",
            "mock"
          ],
          "title": "Data Mode",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "request_parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Parameters"
        }
      },
      "required": [
        "source_type",
        "provider",
        "tool",
        "url",
        "retrieved_at",
        "generated_at",
        "published_at",
        "external_id",
        "verification_status",
        "data_mode"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Корзина (UC-07, UC-08). Согласие на покупку и на риски фиксируются раздельно.",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "cart_id": {
      "title": "Cart Id",
      "type": "string"
    },
    "trip_id": {
      "title": "Trip Id",
      "type": "string"
    },
    "trip_revision": {
      "minimum": 0,
      "title": "Trip Revision",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CartItem"
      },
      "title": "Items",
      "type": "array"
    },
    "total_price": {
      "$ref": "#/$defs/Price"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "awaiting_confirmation",
        "demo_purchased"
      ],
      "title": "Status",
      "type": "string"
    },
    "confirmed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confirmed At"
    },
    "demo_receipt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Demo Receipt Id"
    },
    "risk_acknowledged_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Risk Acknowledged At"
    },
    "confirmation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confirmation Id"
    },
    "significant_unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Significant Unknowns",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "declined_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declined At"
    },
    "demo_notice": {
      "const": "Демонстрационная покупка. Реального бронирования и списания средств нет",
      "default": "Демонстрационная покупка. Реального бронирования и списания средств нет",
      "title": "Demo Notice",
      "type": "string"
    }
  },
  "required": [
    "cart_id",
    "trip_id",
    "trip_revision",
    "items",
    "total_price",
    "completeness",
    "status",
    "confirmed_at",
    "demo_receipt_id",
    "risk_acknowledged_at",
    "confirmation_id",
    "created_at"
  ],
  "title": "Cart",
  "type": "object"
}
