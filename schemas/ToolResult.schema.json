{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odin:contracts:1.0.0:ToolResult",
  "$defs": {
    "SourceReference": {
      "additionalProperties": false,
      "description": "Происхождение существенного факта (DATA-MODE-02, CONTRACT-01).\n\n``verification_status=verified`` означает подтверждение конкретным источником, а не объективную истину.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "mcp",
            "rest_api",
            "local_dataset",
            "mock_generator",
            "editorial",
            "user_input",
            "computed",
            "llm"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "provider": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https?://[^\\s]{1,2000}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrieved At"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generated At"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "External Id"
        },
        "verification_status": {
          "enum": [
            "verified",
            "unverified",
            "conflicting",
            "stale"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "data_mode": {
          "enum": [
            "live",
            "replay",
            "mock"
          ],
          "title": "Data Mode",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "request_parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Parameters"
        }
      },
      "required": [
        "source_type",
        "provider",
        "tool",
        "url",
        "retrieved_at",
        "generated_at",
        "published_at",
        "external_id",
        "verification_status",
        "data_mode"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Результат выполнения инструмента. ``status`` — единственный нормативный список статусов\nвыполнения (CONTRACT-01); не путать с доступностью и ConstraintEvaluation.status.\n\nОтмена по дедлайну: ``status=timeout`` + ``error_code=deadline_cancelled`` (DEC-30).",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "empty",
        "partial",
        "unavailable",
        "error",
        "timeout"
      ],
      "title": "Status",
      "type": "string"
    },
    "data": {
      "title": "Data"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Sources",
      "type": "array"
    },
    "retrieved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retrieved At"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error Code"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "missing": {
      "description": "Для partial — что именно отсутствует",
      "items": {
        "type": "string"
      },
      "title": "Missing",
      "type": "array"
    }
  },
  "required": [
    "call_id",
    "tool_name",
    "provider",
    "status",
    "data",
    "retrieved_at",
    "error_code",
    "latency_ms"
  ],
  "title": "ToolResult",
  "type": "object"
}
