{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odin:contracts:1.0.0:ToolRequest",
  "additionalProperties": false,
  "description": "Запрос логического инструмента. Выполняет только оркестратор через Tool Registry (ARCH-01).",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "call_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Call Id",
      "type": "string"
    },
    "tool_name": {
      "enum": [
        "search_transport",
        "search_hotels",
        "get_offer_details",
        "get_transfer_options",
        "geocode",
        "get_climate",
        "get_weather",
        "get_reviews",
        "suggest_destinations"
      ],
      "title": "Tool Name",
      "type": "string"
    },
    "arguments": {
      "additionalProperties": true,
      "title": "Arguments",
      "type": "object"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "policy_scope": {
      "const": "read_only",
      "title": "Policy Scope",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "call_id",
    "tool_name",
    "arguments",
    "deadline",
    "policy_scope"
  ],
  "title": "ToolRequest",
  "type": "object"
}
