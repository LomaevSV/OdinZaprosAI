{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odin:contracts:1.0.0:TripPlan",
  "$defs": {
    "ConnectionCheck": {
      "additionalProperties": false,
      "description": "Проверка стыка (CONNECTION-02): статус, основание, времена и пояса, буфер, источник.",
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "from_component": {
          "title": "From Component",
          "type": "string"
        },
        "to_component": {
          "title": "To Component",
          "type": "string"
        },
        "status": {
          "enum": [
            "matched",
            "violated",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "times_used": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Times Used",
          "type": "object"
        },
        "timezones": {
          "items": {
            "type": "string"
          },
          "title": "Timezones",
          "type": "array"
        },
        "buffer_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Buffer Minutes"
        },
        "buffer_status": {
          "enum": [
            "approved",
            "proposed_not_approved",
            "none"
          ],
          "title": "Buffer Status",
          "type": "string"
        },
        "margin_minutes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Margin Minutes"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "unknown_reason": {
          "anyOf": [
            {
              "enum": [
                "not_provided_by_source",
                "source_error",
                "timeout",
                "budget_exhausted",
                "not_requested",
                "estimate_only",
                "not_supported_field",
                "mock_data",
                "currency_unresolved",
                "price_incomplete",
                "buffer_not_approved",
                "decision_pending",
                "data_missing",
                "stale"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unknown Reason"
        }
      },
      "required": [
        "check_id",
        "from_component",
        "to_component",
        "status",
        "basis",
        "times_used",
        "timezones",
        "buffer_minutes",
        "buffer_status",
        "margin_minutes",
        "unknown_reason"
      ],
      "title": "ConnectionCheck",
      "type": "object"
    },
    "ConstraintEvaluation": {
      "additionalProperties": false,
      "description": "Оценка условия для кандидата: unknown не равно matched (CONSTRAINT-01).",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "constraint_id": {
          "title": "Constraint Id",
          "type": "string"
        },
        "component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Component Id"
        },
        "plan_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Plan Id"
        },
        "status": {
          "enum": [
            "matched",
            "violated",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "unknown_reason": {
          "anyOf": [
            {
              "enum": [
                "not_provided_by_source",
                "source_error",
                "timeout",
                "budget_exhausted",
                "not_requested",
                "estimate_only",
                "not_supported_field",
                "mock_data",
                "currency_unresolved",
                "price_incomplete",
                "buffer_not_approved",
                "decision_pending",
                "data_missing",
                "stale"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unknown Reason"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "deviation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Deviation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "constraint_id",
        "component_id",
        "plan_id",
        "status",
        "unknown_reason",
        "reason",
        "deviation"
      ],
      "title": "ConstraintEvaluation",
      "type": "object"
    },
    "Deviation": {
      "additionalProperties": false,
      "description": "Величина отклонения при нарушении числового условия (CONSTRAINT-01).",
      "properties": {
        "amount": {
          "description": "Decimal строкой",
          "pattern": "^-?\\d+(\\.\\d{1,2})?$",
          "title": "Amount",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit",
        "description"
      ],
      "title": "Deviation",
      "type": "object"
    },
    "Fee": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "description": "Decimal строкой",
              "pattern": "^\\d+(\\.\\d{1,2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "description": "Код ISO 4217",
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "included": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Included"
        }
      },
      "required": [
        "name",
        "amount",
        "currency",
        "included"
      ],
      "title": "Fee",
      "type": "object"
    },
    "PlanComponent": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "outbound",
            "return",
            "hotel",
            "transfer_in",
            "transfer_out"
          ],
          "title": "Role",
          "type": "string"
        },
        "offer_id": {
          "title": "Offer Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "data_mode": {
          "enum": [
            "live",
            "replay",
            "mock"
          ],
          "title": "Data Mode",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "role",
        "offer_id",
        "kind",
        "title",
        "data_mode"
      ],
      "title": "PlanComponent",
      "type": "object"
    },
    "Price": {
      "additionalProperties": false,
      "description": "Нормативные поля PRICE-01. Полная цена — за всех путешественников и весь период.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "description": "Decimal строкой",
              "pattern": "^\\d+(\\.\\d{1,2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "description": "Код ISO 4217",
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "price_scope": {
          "enum": [
            "per_person",
            "per_seat",
            "party_total",
            "per_night",
            "stay_total",
            "per_room_stay",
            "trip_total",
            "unknown"
          ],
          "title": "Price Scope",
          "type": "string"
        },
        "guests": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Guests"
        },
        "rooms": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rooms"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/PricePeriod"
            },
            {
              "type": "null"
            }
          ]
        },
        "inclusions": {
          "items": {
            "type": "string"
          },
          "title": "Inclusions",
          "type": "array"
        },
        "known_fees": {
          "items": {
            "$ref": "#/$defs/Fee"
          },
          "title": "Known Fees",
          "type": "array"
        },
        "mandatory_fees_status": {
          "enum": [
            "included",
            "excluded_known",
            "unknown",
            "not_applicable"
          ],
          "title": "Mandatory Fees Status",
          "type": "string"
        },
        "total_completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Total Completeness",
          "type": "string"
        },
        "unknown_reason": {
          "anyOf": [
            {
              "enum": [
                "not_provided_by_source",
                "source_error",
                "timeout",
                "budget_exhausted",
                "not_requested",
                "estimate_only",
                "not_supported_field",
                "mock_data",
                "currency_unresolved",
                "price_incomplete",
                "buffer_not_approved",
                "decision_pending",
                "data_missing",
                "stale"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unknown Reason"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency",
        "price_scope",
        "guests",
        "rooms",
        "period",
        "mandatory_fees_status",
        "total_completeness",
        "unknown_reason",
        "source",
        "as_of"
      ],
      "title": "Price",
      "type": "object"
    },
    "PricePeriod": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "PricePeriod",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "Происхождение существенного факта (DATA-MODE-02, CONTRACT-01).\n\n``verification_status=verified`` означает подтверждение конкретным источником, а не объективную истину.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "enum": [
            "mcp",
            "rest_api",
            "local_dataset",
            "mock_generator",
            "editorial",
            "user_input",
            "computed",
            "llm"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "provider": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^https?://[^\\s]{1,2000}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrieved At"
        },
        "generated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generated At"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "external_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "External Id"
        },
        "verification_status": {
          "enum": [
            "verified",
            "unverified",
            "conflicting",
            "stale"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "data_mode": {
          "enum": [
            "live",
            "replay",
            "mock"
          ],
          "title": "Data Mode",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "request_parameters": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Parameters"
        }
      },
      "required": [
        "source_type",
        "provider",
        "tool",
        "url",
        "retrieved_at",
        "generated_at",
        "published_at",
        "external_id",
        "verification_status",
        "data_mode"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "trip_revision": {
      "minimum": 0,
      "title": "Trip Revision",
      "type": "integer"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/PlanComponent"
      },
      "title": "Components",
      "type": "array"
    },
    "total_price": {
      "$ref": "#/$defs/Price"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "connection_checks": {
      "items": {
        "$ref": "#/$defs/ConnectionCheck"
      },
      "title": "Connection Checks",
      "type": "array"
    },
    "constraint_evaluations": {
      "items": {
        "$ref": "#/$defs/ConstraintEvaluation"
      },
      "title": "Constraint Evaluations",
      "type": "array"
    },
    "tradeoffs": {
      "items": {
        "type": "string"
      },
      "title": "Tradeoffs",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "title": "Sources",
      "type": "array"
    },
    "rank_class": {
      "enum": [
        1,
        2,
        3
      ],
      "title": "Rank Class",
      "type": "integer"
    },
    "trip_data_mode": {
      "enum": [
        "live",
        "replay",
        "mock",
        "mixed"
      ],
      "title": "Trip Data Mode",
      "type": "string"
    },
    "data_mode_breakdown": {
      "additionalProperties": {
        "enum": [
          "live",
          "replay",
          "mock"
        ],
        "type": "string"
      },
      "title": "Data Mode Breakdown",
      "type": "object"
    },
    "fully_agreed": {
      "title": "Fully Agreed",
      "type": "boolean"
    },
    "relevance_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Relevance Note"
    }
  },
  "required": [
    "plan_id",
    "trip_revision",
    "components",
    "total_price",
    "completeness",
    "rank_class",
    "trip_data_mode",
    "fully_agreed",
    "relevance_note"
  ],
  "title": "TripPlan",
  "type": "object"
}
