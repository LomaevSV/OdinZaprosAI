# «О!дин запрос» — переменные окружения S1.
# Секретов здесь нет: только имена переменных (SECURITY-01). Реальные значения — в .env (исключён из git).

# Режим данных. В S1 разрешён только mock (DEC-23): Live появится в S2 после DEC-09.
ODIN_DATA_MODE=mock

# LLM. В S1 доступен режим off (DEC-08): структурированная форма без свободного диалога.
# replay — только для реально записанных ответов; live требует ключ и решения DEC-07.
ODIN_LLM_MODE=off
ODIN_LLM_BASE_URL=
ODIN_LLM_MODEL=
ODIN_LLM_API_KEY=
ODIN_LLM_REPLAY_DIR=
ODIN_LLM_MAX_OUTPUT_TOKENS=4000
ODIN_LLM_TIMEOUT_S=20

# Ресурсные лимиты хода (приложение A, provisional — DEC-22).
ODIN_TURN_DEADLINE_S=60
ODIN_TOOL_TIMEOUT_S=20
ODIN_TOOL_RETRIES=1
ODIN_CALLS_PER_TURN=20
ODIN_LLM_CALLS_PER_TURN=4
ODIN_WAVES=2
ODIN_TOP_K=3
ODIN_OFFER_TTL_MINUTES=30

# Хранилище и сервер.
ODIN_DB_PATH=var/odin.sqlite3
ODIN_PORT=8080
ODIN_LOG_LEVEL=INFO
ODIN_CORS_ORIGIN=
