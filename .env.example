# «О!дин запрос» — переменные окружения.
# Секретов здесь нет: только имена переменных (SECURITY-01). Реальные значения — в .env (исключён из git).
# Скопируйте файл: cp .env.example .env — и заполните нужное. Без ключа приложение работает в режиме Mock + форма.

# Режим данных:
#   mock   — только ДЕМО-данные с маркировкой (по умолчанию, без сети);
#   mixed  — Live утверждённых провайдеров (Tutu MCP, Open-Meteo, OSRM); при сбое — Replay, иначе ДЕМО по компоненту;
#   live   — только Live/Replay, без ДЕМО: при сбое честный «неизвестно»;
#   replay — только сохранённые снимки (без сети).
# По умолчанию mixed: реальные данные Tutu/Open-Meteo/OSRM без ключей; без сети — честные ДЕМО-варианты с пометкой.
ODIN_DATA_MODE=mixed
# Каталог локальных снимков Replay (вне git, DEC-24).
ODIN_REPLAY_DIR=var/replay_store

# LLM (OpenAI-совместимый Chat Completions API).
#   off    — без LLM: структурированная форма, свободный текст честно отклоняется (DEC-08);
#   live   — свободный диалог; требует ключ, адрес и модель. Включение live = разрешение на платные вызовы;
#   replay — только реально записанные ответы (ODIN_LLM_REPLAY_DIR).
# Запасные имена, если ODIN_LLM_* пусты: OPENAI_BASE_URL (или OPENAI_API_BASE), OPENAI_API_KEY, OPENAI_MODEL.
ODIN_LLM_MODE=off
# Пример: https://api.openai.com/v1 или адрес совместимого провайдера; для локальной модели — http://localhost:11434/v1
ODIN_LLM_BASE_URL=
ODIN_LLM_MODEL=
ODIN_LLM_API_KEY=
ODIN_LLM_REPLAY_DIR=
ODIN_LLM_MAX_OUTPUT_TOKENS=4000
ODIN_LLM_TIMEOUT_S=20
# response_format=json_object (если провайдер не поддерживает — автоматический повтор без него).
ODIN_LLM_JSON_MODE=true
# 0 — по умолчанию; none — не передавать параметр (для моделей, которые его не принимают).
ODIN_LLM_TEMPERATURE=0
# LLM-Composer: переформулировка ответа по таблице фактов с проверкой чисел (true/false).
ODIN_LLM_COMPOSER=true
# Записывать реальные ответы интерпретатора в ODIN_LLM_REPLAY_DIR для режима replay (локально, вне git).
ODIN_LLM_RECORD=false
ODIN_LLM_RETRIES=1

# Ресурсные лимиты хода (приложение A, provisional — DEC-22).
ODIN_TURN_DEADLINE_S=60
ODIN_TOOL_TIMEOUT_S=20
ODIN_TOOL_RETRIES=1
ODIN_CALLS_PER_TURN=20
ODIN_LLM_CALLS_PER_TURN=4
ODIN_WAVES=2
ODIN_TOP_K=3
ODIN_OFFER_TTL_MINUTES=30

# Хранилище и сервер.
ODIN_DB_PATH=var/odin.sqlite3
ODIN_PORT=8080
ODIN_LOG_LEVEL=INFO
ODIN_CORS_ORIGIN=
